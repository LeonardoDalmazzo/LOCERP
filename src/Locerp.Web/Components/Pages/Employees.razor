    private static bool MatchesSearch(EmployeeListItem employee, string search)
    {
        var normalizedSearch = TrimToNull(search);
        if (normalizedSearch is null)
        {
            return true;
        }

        return ContainsText(employee.DisplayName, normalizedSearch)
            || ContainsText(employee.Email, normalizedSearch)
            || ContainsText(employee.PhoneNumber, normalizedSearch);
    }

    private static bool MatchesAdvancedSearch(EmployeeListItem employee, EmployeeAdvancedSearch search, DateTimeOffset now)
    {
        if (search.Status == EmployeeStatusActive && !employee.IsActive)
        {
            return false;
        }

        if (search.Status == EmployeeStatusInactive && employee.IsActive)
        {
            return false;
        }

        if (search.RoleNames.Count > 0 && !employee.RoleNames.Any(search.RoleNames.Contains))
        {
            return false;
        }

        return search.TemporaryPasswordStatus switch
        {
            TemporaryPasswordStatusActive => employee.MustChangePassword && employee.TemporaryPasswordExpiresAt > now,
            TemporaryPasswordStatusExpired => employee.MustChangePassword && employee.TemporaryPasswordExpiresAt <= now,
            TemporaryPasswordStatusNone => !employee.MustChangePassword,
            _ => true
        };
    }

