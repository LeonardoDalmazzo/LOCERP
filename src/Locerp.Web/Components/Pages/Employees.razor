    private async Task<EmployeeListItem> BuildEmployeeListItemAsync(ApplicationUser user)
    {
        var roles = await UserManager.GetRolesAsync(user);

        return new EmployeeListItem(
            user.Id,
            string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email ?? user.UserName ?? "Funcionario" : user.DisplayName,
            user.Email ?? user.UserName ?? "",
            user.PhoneNumber,
            user.IsActive,
            user.MustChangePassword,
            user.TemporaryPasswordExpiresAt,
            user.CreatedAt,
            roles.Where(role => AppRoles.All.Contains(role)).OrderBy(FormatRole).ToList());
    }

    private static bool HasActiveTemporaryPassword(ApplicationUser user) =>
        user.MustChangePassword && user.TemporaryPasswordExpiresAt > DateTimeOffset.UtcNow;

    private static bool HasActiveTemporaryPassword(EmployeeListItem employee) =>
        employee.MustChangePassword && employee.TemporaryPasswordExpiresAt > DateTimeOffset.UtcNow;

    private string? GetVisibleTemporaryPassword(string employeeId, DateTimeOffset? expiresAt)
    {
        if (expiresAt is null || expiresAt.Value <= DateTimeOffset.UtcNow)
        {
            visibleTemporaryPasswords.Remove(employeeId);
            return null;
        }

        return visibleTemporaryPasswords.TryGetValue(employeeId, out var password) ? password : null;
    }

    private static string GenerateTemporaryPassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnopqrstuvwxyz";
        const string digits = "23456789";
        const string symbols = "!@#$%";
        const string all = upper + lower + digits + symbols;

        return string.Concat(
            RandomChar(upper),
            RandomChar(lower),
            RandomChar(digits),
            RandomChar(symbols),
            RandomString(all, 8));
    }

    private static char RandomChar(string values) => values[RandomNumberGenerator.GetInt32(values.Length)];

    private static string RandomString(string values, int length)
    {
        return string.Concat(Enumerable.Range(0, length).Select(_ => RandomChar(values)));
    }

    private static string FormatPhoneInput(string? phoneNumber)
    {
        var digits = OnlyDigits(phoneNumber);
        if (digits.Length > 11)
        {
            digits = digits[..11];
        }

        if (digits.Length <= 2)
        {
            return digits;
        }

        if (digits.Length <= 6)
        {
            return $"({digits[..2]}) {digits[2..]}";
        }

        if (digits.Length <= 10)
        {
            return $"({digits[..2]}) {digits[2..6]}-{digits[6..]}";
        }

        return $"({digits[..2]}) {digits[2..7]}-{digits[7..]}";
    }

    private static string OnlyDigits(string? value) => new((value ?? "").Where(char.IsDigit).ToArray());

    private static string? TrimToNull(string? value)
    {
        var trimmed = value?.Trim();
        return string.IsNullOrWhiteSpace(trimmed) ? null : trimmed;
    }

    private static string CompactText(string? value)
    {
        var parts = (value ?? "").Trim().Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Join(" ", parts);
    }

    private static bool ContainsText(string? value, string search) =>
        value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private static string FirstFilled(params string?[] values)
    {
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "-";
    }

    private static string FormatRoles(IReadOnlyList<string> roleNames)
    {
        return roleNames.Count == 0 ? "-" : string.Join(", ", roleNames.Select(FormatRole));
    }

    private static string FormatRole(string role) => role switch
    {
        AppRoles.Administrador => "Administrador",
        AppRoles.Gerente => "Gerente",
        AppRoles.Vendedor => "Vendedor",
        _ => role
    };

    private static string FormatTemporaryPasswordStatus(EmployeeListItem employee)
    {
        if (!employee.MustChangePassword)
        {
            return "Sem pendencia";
        }

        if (employee.TemporaryPasswordExpiresAt is null)
        {
            return "Troca obrigatoria";
        }

        if (employee.TemporaryPasswordExpiresAt <= DateTimeOffset.UtcNow)
        {
            return "Expirada";
        }

        return $"Ativa ate {employee.TemporaryPasswordExpiresAt.Value.ToLocalTime():dd/MM HH:mm}";
    }

    private static string FormatTemporaryPasswordTimeRemaining(DateTimeOffset? expiresAt)
    {
        if (expiresAt is null)
        {
            return "-";
        }

        var remaining = expiresAt.Value - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "Expirada";
        }

        return remaining.TotalHours >= 1
            ? $"{(int)remaining.TotalHours}h {remaining.Minutes}min"
            : $"{remaining.Minutes}min";
    }

    private static string GetTemporaryPasswordCssClass(EmployeeListItem employee)
    {
        return employee.MustChangePassword && employee.TemporaryPasswordExpiresAt > DateTimeOffset.UtcNow
            ? "status-pill-active"
            : "status-pill-inactive";
    }

    private sealed class EmployeeInput
    {
        [Required(ErrorMessage = "Informe o nome.")]
        [MaxLength(120, ErrorMessage = "Nome muito longo.")]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Informe o email.")]
        [EmailAddress(ErrorMessage = "Informe um email valido.")]
        [MaxLength(256, ErrorMessage = "Email muito longo.")]
        public string Email { get; set; } = "";

        [MaxLength(15, ErrorMessage = "Telefone muito longo.")]
        public string? PhoneNumber { get; set; }

        public bool IsActive { get; set; } = true;

        [MaxLength(100, ErrorMessage = "Senha provisoria muito longa.")]
        public string TemporaryPassword { get; set; } = "";

        public HashSet<string> RoleNames { get; } = [];
    }

    private sealed class EmployeeAdvancedSearch
    {
        public string Status { get; set; } = "";

        public string TemporaryPasswordStatus { get; set; } = "";

        public HashSet<string> RoleNames { get; } = [];

        public int ActiveFilterCount
        {
            get
            {
                var count = 0;
                count += string.IsNullOrWhiteSpace(Status) ? 0 : 1;
                count += string.IsNullOrWhiteSpace(TemporaryPasswordStatus) ? 0 : 1;
                count += RoleNames.Count == 0 ? 0 : 1;
                return count;
            }
        }

        public EmployeeAdvancedSearch Clone()
        {
            var clone = new EmployeeAdvancedSearch
            {
                Status = Status,
                TemporaryPasswordStatus = TemporaryPasswordStatus
            };

            foreach (var role in RoleNames)
            {
                clone.RoleNames.Add(role);
            }

            return clone;
        }
    }

    private sealed record EmployeeListItem(
        string Id,
        string DisplayName,
        string Email,
        string? PhoneNumber,
        bool IsActive,
        bool MustChangePassword,
        DateTimeOffset? TemporaryPasswordExpiresAt,
        DateTimeOffset CreatedAt,
        IReadOnlyList<string> RoleNames);
}
