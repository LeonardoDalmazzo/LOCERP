        customerInput.SellerId = "";
        customerInput.CompanyName = null;
        customerInput.Origin = CustomerOrigin.Site.ToString();
        customerInput.Notes = null;
        customerInput.Addresses.Clear();
        addressInput = new();
        isCustomerFormOpen = false;
        isAddingCustomerOrigin = false;
        isAddingAddressType = false;
        newCustomerOriginName = "";
        newAddressTypeName = "";
        customerOriginOptionMessage = null;
        addressTypeOptionMessage = null;
        formMessage = null;
        addressMessage = null;
    }

    private void SetFormError(string message)
    {
        formMessage = message;
        formMessageIsError = true;
    }

    private void SetAddressError(string message)
    {
        addressMessage = message;
        addressMessageIsError = true;
    }

    private static string OnlyDigits(string? value) => new((value ?? "").Where(char.IsDigit).ToArray());

    private static string? TrimToNull(string? value)
    {
        var trimmed = value?.Trim();
        return string.IsNullOrWhiteSpace(trimmed) ? null : trimmed;
    }

    private static string? NormalizeWebsite(string? value)
    {
        var trimmed = TrimToNull(value);
        if (trimmed is null)
        {
            return null;
        }

        return trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? trimmed
            : $"https://{trimmed}";
    }

    private void ApplyCustomerInput(Customer customer, string documentNumber, string sellerId)
    {
        customer.Type = customerInput.Type;
        customer.Status = customerInput.Status;
        customer.DocumentNumber = documentNumber;
        customer.Name = customerInput.Name.Trim();
        customer.Email = TrimToNull(customerInput.Email);
        customer.BusinessPhone = TrimToNull(customerInput.BusinessPhone);
        customer.MobilePhone = TrimToNull(customerInput.MobilePhone);
        customer.Website = NormalizeWebsite(customerInput.Website);
        customer.SellerId = sellerId;
        customer.CompanyName = TrimToNull(customerInput.CompanyName);
        customer.Origin = customerInput.Origin;
        customer.Notes = TrimToNull(customerInput.Notes);
    }

    private static CustomerAddress CreateCustomerAddress(AddressInput address) => new()
    {
        Type = address.Type,
        PostalCode = OnlyDigits(address.PostalCode),
        Street = address.Street.Trim(),
        Number = address.Number.Trim(),
        Neighborhood = address.Neighborhood.Trim(),
        City = address.City.Trim(),
        State = address.State.Trim().ToUpperInvariant(),
        Complement = TrimToNull(address.Complement)
    };

    private static string FirstFilled(params string?[] values)
    {
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "-";
    }

    private static string FormatDocument(string documentNumber, CustomerType type)
    {
        var digits = OnlyDigits(documentNumber);
        if (type == CustomerType.Individual && digits.Length == 11)
        {
            return $"{digits[..3]}.{digits[3..6]}.{digits[6..9]}-{digits[9..]}";
        }

        if (type == CustomerType.Company && digits.Length == 14)
        {
            return $"{digits[..2]}.{digits[2..5]}.{digits[5..8]}/{digits[8..12]}-{digits[12..]}";
        }

        return documentNumber;
    }

    private static string FormatPostalCode(string postalCode)
    {
        var digits = OnlyDigits(postalCode);
        return digits.Length == 8 ? $"{digits[..5]}-{digits[5..]}" : postalCode;
    }

    private static string FormatPostalCodeInput(string? postalCode)
    {
        var digits = OnlyDigits(postalCode);
        if (digits.Length > 8)
        {
            digits = digits[..8];
        }

        return digits.Length > 5 ? $"{digits[..5]}-{digits[5..]}" : digits;
    }

    private static string FormatAddressLine(AddressInput address)
    {
        var complement = string.IsNullOrWhiteSpace(address.Complement) ? "" : $" - {address.Complement}";
        return $"{address.Street}, {address.Number}{complement} - {address.Neighborhood}, {address.City}/{address.State}";
    }

    private static IReadOnlyList<DropdownOption> DefaultCustomerOriginOptions { get; } =
        Enum.GetValues<CustomerOrigin>()
            .Select(origin => new DropdownOption(origin.ToString(), FormatCustomerOrigin(origin)))
            .ToList();

    private static IReadOnlyList<DropdownOption> DefaultAddressTypeOptions { get; } =
        Enum.GetValues<CustomerAddressType>()
            .Select(type => new DropdownOption(type.ToString(), FormatAddressType(type)))
            .ToList();

    private static List<DropdownOption> BuildDropdownOptions(
        CustomerDropdownOptionKind kind,
        IReadOnlyList<DropdownOption> defaultOptions,
        IEnumerable<CustomerDropdownOptionListItem> customOptions)
    {
        var options = defaultOptions.ToList();
        var knownNames = options
            .SelectMany(option => new[] { option.Value, option.Label })
            .Select(NormalizeOptionName)
            .ToHashSet(StringComparer.Ordinal);

        foreach (var option in customOptions.Where(option => option.Kind == kind))
        {
            var name = CompactOptionName(option.Name);
            var normalizedName = NormalizeOptionName(name);

            if (string.IsNullOrWhiteSpace(name) || !knownNames.Add(normalizedName))
            {
                continue;
            }

            options.Add(new DropdownOption(name, name));
        }

        return options;
    }

    private static string CompactOptionName(string? value)
    {
        var parts = (value ?? "").Trim().Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Join(" ", parts);
    }

    private static string NormalizeOptionName(string? value) => CompactOptionName(value).ToUpperInvariant();

    private static string FormatCustomerType(CustomerType type) => type switch
    {
        CustomerType.Individual => "Pessoa fisica",
        CustomerType.Company => "Pessoa juridica",
        _ => type.ToString()
    };

    private static string FormatCustomerStatus(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => "Ativo",
        CustomerStatus.Inactive => "Inativo",
        _ => status.ToString()
    };

    private static string FormatCustomerOrigin(string origin) =>
        Enum.TryParse<CustomerOrigin>(origin, out var knownOrigin) ? FormatCustomerOrigin(knownOrigin) : origin;

    private static string FormatCustomerOrigin(CustomerOrigin origin) => origin switch
    {
        CustomerOrigin.Site => "Site",
        CustomerOrigin.Instagram => "Instagram",
        CustomerOrigin.Referral => "Indicacao",
        CustomerOrigin.Builder => "Construtora",
        CustomerOrigin.Facebook => "Facebook",
        CustomerOrigin.FormerCustomer => "Cliente antigo",
        _ => origin.ToString()
    };

    private static string FormatAddressType(string type) =>
        Enum.TryParse<CustomerAddressType>(type, out var knownType) ? FormatAddressType(knownType) : type;

    private static string FormatAddressType(CustomerAddressType type) => type switch
    {
        CustomerAddressType.Residential => "Residencial",
        CustomerAddressType.Business => "Empresarial",
        CustomerAddressType.JobSite => "Local da obra",
        _ => type.ToString()
    };

    private sealed class CustomerInput
    {
        public CustomerType Type { get; set; } = CustomerType.Individual;

        public CustomerStatus Status { get; set; } = CustomerStatus.Active;

        [Required(ErrorMessage = "Informe o documento.")]
        [MaxLength(18, ErrorMessage = "Documento muito longo.")]
        public string DocumentNumber { get; set; } = "";

        [Required(ErrorMessage = "Informe o nome.")]
        [MaxLength(160, ErrorMessage = "Nome muito longo.")]
        public string Name { get; set; } = "";

        [EmailAddress(ErrorMessage = "Informe um e-mail valido.")]
        [MaxLength(256, ErrorMessage = "E-mail muito longo.")]
        public string? Email { get; set; }

        [MaxLength(30, ErrorMessage = "Telefone comercial muito longo.")]
        public string? BusinessPhone { get; set; }

        [MaxLength(30, ErrorMessage = "Telefone celular muito longo.")]
        public string? MobilePhone { get; set; }

        [MaxLength(200, ErrorMessage = "Site muito longo.")]
        public string? Website { get; set; }

        [Required(ErrorMessage = "Selecione o vendedor responsavel.")]
        public string? SellerId { get; set; } = "";

        [MaxLength(160, ErrorMessage = "Empresa/construtora muito longa.")]
        public string? CompanyName { get; set; }

        [Required(ErrorMessage = "Selecione a origem do cliente.")]
        [MaxLength(80, ErrorMessage = "Origem do cliente muito longa.")]
        public string Origin { get; set; } = CustomerOrigin.Site.ToString();

        [MaxLength(1000, ErrorMessage = "Observacoes muito longas.")]
        public string? Notes { get; set; }

        public List<AddressInput> Addresses { get; } = [];
    }

    private sealed class AddressInput
    {
        public string Type { get; set; } = CustomerAddressType.Residential.ToString();

        public string PostalCode { get; set; } = "";

        public string Street { get; set; } = "";

        public string Number { get; set; } = "";

        public string Neighborhood { get; set; } = "";

        public string City { get; set; } = "";

        public string State { get; set; } = "";

        public string? Complement { get; set; }
    }

    private sealed record SellerOption(string Id, string Name);

    private sealed record DropdownOption(string Value, string Label);

    private sealed record CustomerDropdownOptionListItem(CustomerDropdownOptionKind Kind, string Name);

    private sealed record DropdownOptionSaveResult(bool IsSuccess, string Value, string Message)
    {
        public static DropdownOptionSaveResult Success(string value, string message) => new(true, value, message);

        public static DropdownOptionSaveResult Error(string message) => new(false, "", message);
    }

    private sealed class CustomerAdvancedSearch
    {
        public string CustomerType { get; set; } = "";

        public string Status { get; set; } = "";

        public string AddressType { get; set; } = "";

        public HashSet<string> OriginValues { get; } = [];

        public HashSet<string> SellerIds { get; } = [];

        public int ActiveFilterCount
        {
            get
            {
                var count = 0;
                count += string.IsNullOrWhiteSpace(CustomerType) ? 0 : 1;
                count += string.IsNullOrWhiteSpace(Status) ? 0 : 1;
                count += OriginValues.Count == 0 ? 0 : 1;
                count += string.IsNullOrWhiteSpace(AddressType) ? 0 : 1;
                count += SellerIds.Count == 0 ? 0 : 1;
                return count;
            }
        }

        public CustomerAdvancedSearch Clone()
        {
            var clone = new CustomerAdvancedSearch
            {
                CustomerType = CustomerType,
                Status = Status,
                AddressType = AddressType
            };

            foreach (var origin in OriginValues)
            {
                clone.OriginValues.Add(origin);
            }

            foreach (var sellerId in SellerIds)
            {
                clone.SellerIds.Add(sellerId);
            }

            return clone;
        }
    }

