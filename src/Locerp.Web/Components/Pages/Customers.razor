    private void CancelCustomerOriginOption()
    {
        isAddingCustomerOrigin = false;
        newCustomerOriginName = "";
        customerOriginOptionMessage = null;
    }

    private void CancelAddressTypeOption()
    {
        isAddingAddressType = false;
        newAddressTypeName = "";
        addressTypeOptionMessage = null;
    }

    private async Task SaveCustomerOriginOptionAsync()
    {
        if (isSavingCustomerOriginOption)
        {
            return;
        }

        isSavingCustomerOriginOption = true;
        customerOriginOptionMessage = null;

        try
        {
            var result = await CreateDropdownOptionAsync(
                CustomerDropdownOptionKind.CustomerOrigin,
                newCustomerOriginName,
                customerOriginOptions);

            if (!result.IsSuccess)
            {
                customerOriginOptionMessage = result.Message;
                customerOriginOptionMessageIsError = true;
                return;
            }

            await LoadDropdownOptionsAsync();
            customerInput.Origin = result.Value;
            isAddingCustomerOrigin = false;
            newCustomerOriginName = "";
            customerOriginOptionMessage = result.Message;
            customerOriginOptionMessageIsError = false;
        }
        finally
        {
            isSavingCustomerOriginOption = false;
        }
    }

    private async Task SaveAddressTypeOptionAsync()
    {
        if (isSavingAddressTypeOption)
        {
            return;
        }

        isSavingAddressTypeOption = true;
        addressTypeOptionMessage = null;

        try
        {
            var result = await CreateDropdownOptionAsync(
                CustomerDropdownOptionKind.AddressType,
                newAddressTypeName,
                addressTypeOptions);

            if (!result.IsSuccess)
            {
                addressTypeOptionMessage = result.Message;
                addressTypeOptionMessageIsError = true;
                return;
            }

            await LoadDropdownOptionsAsync();
            addressInput.Type = result.Value;
            isAddingAddressType = false;
            newAddressTypeName = "";
            addressTypeOptionMessage = result.Message;
            addressTypeOptionMessageIsError = false;
        }
        finally
        {
            isSavingAddressTypeOption = false;
        }
    }

    private async Task<DropdownOptionSaveResult> CreateDropdownOptionAsync(
        CustomerDropdownOptionKind kind,
        string name,
        IReadOnlyList<DropdownOption> currentOptions)
    {
        var optionName = CompactOptionName(name);
        if (string.IsNullOrWhiteSpace(optionName))
        {
            return DropdownOptionSaveResult.Error("Informe o nome da nova opcao.");
        }

        if (optionName.Length > DropdownOptionNameMaxLength)
        {
            return DropdownOptionSaveResult.Error($"Use ate {DropdownOptionNameMaxLength} caracteres.");
        }

        var normalizedName = NormalizeOptionName(optionName);
        var existingOption = currentOptions.FirstOrDefault(option =>
            NormalizeOptionName(option.Label) == normalizedName
            || NormalizeOptionName(option.Value) == normalizedName);

        if (existingOption is not null)
        {
            return DropdownOptionSaveResult.Success(existingOption.Value, "Opcao ja existente selecionada.");
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var persistedOption = await dbContext.CustomerDropdownOptions
            .FirstOrDefaultAsync(option => option.Kind == kind && option.NormalizedName == normalizedName);

        if (persistedOption is not null)
        {
            return DropdownOptionSaveResult.Success(persistedOption.Name, "Opcao ja existente selecionada.");
        }

        dbContext.CustomerDropdownOptions.Add(new CustomerDropdownOption
        {
            Kind = kind,
            Name = optionName,
            NormalizedName = normalizedName
        });

        try
        {
            await dbContext.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            return DropdownOptionSaveResult.Error("Nao foi possivel adicionar a opcao. Tente novamente.");
        }

        return DropdownOptionSaveResult.Success(optionName, "Opcao adicionada e selecionada.");
    }

    private void MaskPostalCodeInput(ChangeEventArgs args)
    {
        addressInput.PostalCode = FormatPostalCodeInput(args.Value?.ToString());
    }

    private async Task LookupAddressByPostalCodeAsync()
    {
        if (isLookingUpAddress)
        {
            return;
        }

        var digits = OnlyDigits(addressInput.PostalCode);
        if (digits.Length != 8)
        {
            addressMessage = "Informe um CEP com 8 digitos para buscar automaticamente.";
            addressMessageIsError = true;
            return;
        }

        isLookingUpAddress = true;
        addressMessage = null;

        var address = await ViaCepLookup.FindAddressAsync(digits);

        if (address is null)
        {
            addressMessage = "CEP nao localizado. Preencha o endereco manualmente.";
            addressMessageIsError = true;
        }
        else
        {
            addressInput.PostalCode = FormatPostalCode(address.PostalCode);
            addressInput.Street = address.Street;
            addressInput.Neighborhood = address.Neighborhood;
            addressInput.City = address.City;
            addressInput.State = address.State;
            addressMessage = "Endereco localizado pelo CEP.";
            addressMessageIsError = false;
        }

        isLookingUpAddress = false;
    }

    private void AddAddress()
    {
        var postalCode = OnlyDigits(addressInput.PostalCode);
        var state = (addressInput.State ?? "").Trim().ToUpperInvariant();

        if (postalCode.Length != 8)
        {
            SetAddressError("Informe um CEP valido com 8 digitos.");
            return;
        }

        if (string.IsNullOrWhiteSpace(addressInput.Street)
            || string.IsNullOrWhiteSpace(addressInput.Number)
            || string.IsNullOrWhiteSpace(addressInput.Neighborhood)
            || string.IsNullOrWhiteSpace(addressInput.City)
            || state.Length != 2)
        {
            SetAddressError("Preencha logradouro, numero, bairro, cidade e UF antes de adicionar.");
            return;
        }

        customerInput.Addresses.Add(new AddressInput
        {
            Type = addressInput.Type,
            PostalCode = postalCode,
            Street = addressInput.Street.Trim(),
            Number = addressInput.Number.Trim(),
            Neighborhood = addressInput.Neighborhood.Trim(),
            City = addressInput.City.Trim(),
            State = state,
            Complement = TrimToNull(addressInput.Complement)
        });

        addressInput = new();
        addressMessage = "Endereco adicionado ao cliente.";
        addressMessageIsError = false;
    }

    private void RemoveAddress(int index)
    {
        if (index < 0 || index >= customerInput.Addresses.Count)
        {
            return;
        }

        customerInput.Addresses.RemoveAt(index);
    }

    private async Task SaveCustomerAsync()
    {
        formMessage = null;
        formMessageIsError = false;
        var customerId = editingCustomerId;
        var isEditing = customerId is not null;

        var documentNumber = OnlyDigits(customerInput.DocumentNumber);
        var expectedDocumentLength = customerInput.Type == CustomerType.Individual ? 11 : 14;
        if (documentNumber.Length != expectedDocumentLength)
        {
            SetFormError($"Informe um {DocumentLabel} valido.");
            return;
        }

        if (customerInput.Addresses.Count == 0)
        {
            SetFormError("Adicione ao menos um endereco para o cliente.");
            return;
        }

        var seller = await UserManager.FindByIdAsync(customerInput.SellerId ?? "");
        if (seller is null || !await UserManager.IsInRoleAsync(seller, AppRoles.Vendedor))
        {
            SetFormError("Selecione um vendedor responsavel valido.");
            return;
        }

        isSaving = true;

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var documentExists = await dbContext.Customers.AnyAsync(customer => customer.DocumentNumber == documentNumber && customer.Id != customerId);
        if (documentExists)
        {
            isSaving = false;
            SetFormError("Ja existe um cliente cadastrado com este documento.");
            return;
        }

        try
        {
            if (isEditing)
            {
                var customer = await dbContext.Customers
                    .Include(customer => customer.Addresses)
                    .FirstOrDefaultAsync(customer => customer.Id == customerId);

                if (customer is null)
                {
                    SetFormError("Cliente nao localizado para edicao.");
                    return;
                }

                ApplyCustomerInput(customer, documentNumber, seller.Id);
                customer.UpdatedAt = DateTimeOffset.UtcNow;
                dbContext.CustomerAddresses.RemoveRange(customer.Addresses.ToList());
                customer.Addresses.Clear();

                foreach (var address in customerInput.Addresses.Select(CreateCustomerAddress))
                {
                    customer.Addresses.Add(address);
                }
            }
            else
            {
                var customer = new Customer();
                ApplyCustomerInput(customer, documentNumber, seller.Id);

                foreach (var address in customerInput.Addresses.Select(CreateCustomerAddress))
                {
                    customer.Addresses.Add(address);
                }

                dbContext.Customers.Add(customer);
            }

            await dbContext.SaveChangesAsync();
            ResetForm();
            formMessage = isEditing ? "Cliente atualizado com sucesso." : "Cliente cadastrado com sucesso.";
            formMessageIsError = false;
            pendingDeleteCustomerId = null;
            await LoadCustomersAsync();
        }
        catch (DbUpdateException)
        {
            SetFormError("Nao foi possivel salvar o cliente. Verifique os dados e tente novamente.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task EditCustomerAsync(int customerId)
    {
        formMessage = null;
        addressMessage = null;
        viewingCustomer = null;
        pendingDeleteCustomerId = null;

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var customer = await dbContext.Customers
            .AsNoTracking()
            .Include(customer => customer.Addresses)
            .FirstOrDefaultAsync(customer => customer.Id == customerId);

        if (customer is null)
        {
            SetFormError("Cliente nao localizado para edicao.");
            return;
        }

        editingCustomerId = customer.Id;
        customerInput.Type = customer.Type;
        customerInput.Status = customer.Status;
        customerInput.DocumentNumber = FormatDocument(customer.DocumentNumber, customer.Type);
        customerInput.Name = customer.Name;
        customerInput.Email = customer.Email;
        customerInput.BusinessPhone = customer.BusinessPhone;
        customerInput.MobilePhone = customer.MobilePhone;
        customerInput.Website = customer.Website;
        customerInput.SellerId = customer.SellerId;
        customerInput.CompanyName = customer.CompanyName;
        customerInput.Origin = customer.Origin;
        customerInput.Notes = customer.Notes;
        customerInput.Addresses.Clear();

        foreach (var address in customer.Addresses.OrderBy(address => address.Id))
        {
            customerInput.Addresses.Add(new AddressInput
            {
                Type = address.Type,
                PostalCode = FormatPostalCode(address.PostalCode),
                Street = address.Street,
                Number = address.Number,
                Neighborhood = address.Neighborhood,
                City = address.City,
                State = address.State,
                Complement = address.Complement
            });
        }

        addressInput = new();
        isAddingCustomerOrigin = false;
        isAddingAddressType = false;
        newCustomerOriginName = "";
        newAddressTypeName = "";
        customerOriginOptionMessage = null;
        addressTypeOptionMessage = null;
        formMessage = $"Editando {customer.Name}.";
        formMessageIsError = false;
        isCustomerFormOpen = true;
    }

    private async Task ViewCustomerAsync(int customerId)
    {
        formMessage = null;
        pendingDeleteCustomerId = null;

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var customer = await dbContext.Customers
            .AsNoTracking()
            .Include(customer => customer.Seller)
            .Include(customer => customer.Addresses)
            .FirstOrDefaultAsync(customer => customer.Id == customerId);

        if (customer is null)
        {
            SetFormError("Cliente nao localizado para visualizacao.");
            return;
        }

        viewingCustomer = new CustomerDetails(
            customer.Id,
            customer.Type,
            customer.Status,
            customer.DocumentNumber,
            customer.Name,
            customer.Email,
            customer.BusinessPhone,
            customer.MobilePhone,
            customer.Website,
            customer.CompanyName,
            customer.Origin,
            string.IsNullOrWhiteSpace(customer.Seller.DisplayName) ? customer.Seller.Email ?? customer.Seller.UserName ?? "Vendedor" : customer.Seller.DisplayName,
            customer.Notes,
            customer.Addresses
                .OrderBy(address => address.Id)
                .Select(address => new AddressInput
                {
                    Type = address.Type,
                    PostalCode = FormatPostalCode(address.PostalCode),
                    Street = address.Street,
                    Number = address.Number,
                    Neighborhood = address.Neighborhood,
                    City = address.City,
                    State = address.State,
                    Complement = address.Complement
                })
                .ToList());

        isCustomerFormOpen = false;
    }

    private void CloseCustomerDetails()
    {
        viewingCustomer = null;
    }

    private void RequestDeleteCustomer(int customerId)
    {
        pendingDeleteCustomerId = customerId;
    }

    private void CancelDeleteCustomer()
    {
        pendingDeleteCustomerId = null;
    }

    private async Task DeleteCustomerAsync(int customerId)
    {
        if (pendingDeleteCustomerId != customerId)
        {
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var customer = await dbContext.Customers.FirstOrDefaultAsync(customer => customer.Id == customerId);

        if (customer is null)
        {
            pendingDeleteCustomerId = null;
            SetFormError("Cliente nao localizado para exclusao.");
            await LoadCustomersAsync();
            return;
        }

        try
        {
            dbContext.Customers.Remove(customer);
            await dbContext.SaveChangesAsync();
            pendingDeleteCustomerId = null;
            formMessage = "Cliente excluido com sucesso.";
            formMessageIsError = false;
            await LoadCustomersAsync();
        }
        catch (DbUpdateException)
        {
            SetFormError("Nao foi possivel excluir o cliente. Verifique se ha registros vinculados.");
        }
    }

